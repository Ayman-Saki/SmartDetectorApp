<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/permissions_fragment">

    <!-- ================= LOGIN ================= -->
    <fragment
        android:id="@+id/loginFragment"
        android:name="org.tensorflow.lite.examples.imageclassification.fragments.LoginFragment"
        android:label="Login"
        tools:layout="@layout/activity_login_fragment">

        <action
            android:id="@+id/action_login_to_register"
            app:destination="@id/registerFragment" />

        <action
            android:id="@+id/action_login_to_camera"
            app:destination="@id/camera_fragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- ================= REGISTER ================= -->
    <fragment
        android:id="@+id/registerFragment"
        android:name="org.tensorflow.lite.examples.imageclassification.fragments.RegisterFragment"
        android:label="Register"
        tools:layout="@layout/activity_register_fragment">

        <action
            android:id="@+id/action_register_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/registerFragment"
            app:popUpToInclusive="true" />

        <action
            android:id="@+id/action_register_to_camera"
            app:destination="@id/camera_fragment"
            app:popUpTo="@id/registerFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- ================= PROFILE ================= -->
    <fragment
        android:id="@+id/profileFragment"
        android:name="org.tensorflow.lite.examples.imageclassification.fragments.ProfileFragment"
        android:label="Profile"
        tools:layout="@layout/activity_profile_fragment" />

    <!-- ================= PERMISSIONS (START HERE) ================= -->
    <fragment
        android:id="@+id/permissions_fragment"
        android:name="org.tensorflow.lite.examples.imageclassification.fragments.PermissionsFragment"
        android:label="Permissions">

        <action
            android:id="@+id/action_permissions_to_camera"
            app:destination="@id/camera_fragment"
            app:popUpTo="@id/permissions_fragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- ================= CAMERA ================= -->
    <fragment
        android:id="@+id/camera_fragment"
        android:name="org.tensorflow.lite.examples.imageclassification.fragments.CameraFragment"
        android:label="Camera"
        tools:layout="@layout/fragment_camera">

        <action
            android:id="@+id/action_camera_to_profile"
            app:destination="@id/profileFragment" />
    </fragment>

    <!-- ================= HISTORY ================= -->
    <fragment
        android:id="@+id/history_fragment"
        android:name="org.tensorflow.lite.examples.imageclassification.fragments.HistoryFragment"
        android:label="Historique"
        tools:layout="@layout/fragment_history" />

    <!-- ================= SETTINGS ================= -->
    <fragment
        android:id="@+id/settings_fragment"
        android:name="org.tensorflow.lite.examples.imageclassification.fragments.SettingsFragment"
        android:label="Paramètres"
        tools:layout="@layout/fragment_settings" />

    <!-- ================= QR code ================= -->

    <fragment
        android:id="@+id/qrFragment"
        android:name="org.tensorflow.lite.examples.imageclassification.fragments.QrFragment"
        android:label="QR Code"
        tools:layout="@layout/fragment_qr_display" />

</navigation>